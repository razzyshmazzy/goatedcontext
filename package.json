{
  "name": "goatedcontext",
  "version": "0.3.2",
  "description": "A persistent, local-first developer-context layer for AI coding agents. Your preferences follow you across repos and reach Claude Code, OpenAI Codex, and Cursor automatically.",
  "type": "module",
  "license": "MIT",
  "author": "razzyshmazzy",
  "homepage": "https://github.com/razzyshmazzy/goatedcontext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razzyshmazzy/goatedcontext.git"
  },
  "bugs": {
    "url": "https://github.com/razzyshmazzy/goatedcontext/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "ai",
    "context",
    "developer-preferences",
    "cli",
    "local-first",
    "sqlite"
  ],
  "bin": {
    "goatedcontext": "dist/index.js",
    "ctx": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "ctx": "bun run src/index.ts",
    "build": "bun run scripts/build.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.5.0"
  }
}
