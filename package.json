{
  "name": "goatedcontext",
  "version": "0.4.4",
  "description": "Local, shared developer memory for any AI coding agent. Works with any agent that speaks MCP, can invoke a subprocess, or reads AGENTS.md. Native zero-config integrations for Claude Code, OpenAI Codex, and Cursor.",
  "type": "module",
  "license": "MIT",
  "author": "razzyshmazzy",
  "homepage": "https://github.com/razzyshmazzy/goatedcontext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razzyshmazzy/goatedcontext.git"
  },
  "bugs": {
    "url": "https://github.com/razzyshmazzy/goatedcontext/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "model-context-protocol",
    "ai",
    "ai-agents",
    "context",
    "developer-preferences",
    "cli",
    "local-first",
    "sqlite"
  ],
  "bin": {
    "goatedcontext": "dist/index.js",
    "ctx": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "INTEGRATING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "ctx": "bun run src/index.ts",
    "build": "bun run scripts/build.mjs",
    "test": "bun test",
    "bench": "bun run scripts/bench/diagnostics.ts",
    "stress": "bun run scripts/stress.ts",
    "smoke:mcp": "bun run scripts/smoke/mcp.ts",
    "bench:memory": "bun run benchmarks/developer-memory/src/cli.ts run",
    "bench:memory:demo": "bun run benchmarks/developer-memory/src/cli.ts demo",
    "bench:memory:full": "bun run benchmarks/developer-memory/src/cli.ts full",
    "bench:memory:check": "bun test ./benchmarks/developer-memory/tests/ctx-participation.check.ts",
    "bench:memory:typecheck": "tsc --noEmit -p benchmarks/developer-memory/tsconfig.json",
    "bench:pull:deterministic": "bun run benchmarks/autonomous-pull/cli.ts deterministic",
    "bench:pull:corpus": "bun run benchmarks/autonomous-pull/cli.ts corpus",
    "bench:pull:pilot": "bun run benchmarks/autonomous-pull/cli.ts pilot",
    "bench:pull:check": "bun test ./benchmarks/autonomous-pull/tests/score.test.ts ./benchmarks/autonomous-pull/tests/retrieval-corpus.test.ts",
    "bench:pull:typecheck": "tsc --noEmit -p benchmarks/autonomous-pull/tsconfig.json",
    "bench:save:deterministic": "bun run benchmarks/autonomous-save/cli.ts deterministic",
    "bench:save:pilot": "bun run benchmarks/autonomous-save/cli.ts pilot",
    "bench:save:check": "bun test ./benchmarks/autonomous-save/tests/score.test.ts",
    "bench:save:typecheck": "tsc --noEmit -p benchmarks/autonomous-save/tsconfig.json",
    "bench:overseer": "bun run benchmarks/overseer/cli.ts",
    "bench:overseer:check": "bun test ./benchmarks/overseer/tests/score.test.ts",
    "bench:overseer:typecheck": "tsc --noEmit -p benchmarks/overseer/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run build && bun test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "string-width": "^8.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/bun": "^1.1.0",
    "typescript": "^5.5.0"
  }
}
